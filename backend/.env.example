# SYNCHROFLOW AI Backend Environment Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://*

# Protocol & Versioning
PROTOCOL_VERSION=v1.2.0

# Simulation Core
SIMULATION_STEP_DT=0.1
DEFAULT_SEED=42
AUTOPLAY_ON_STARTUP=true

# SUMO Integration (Stage 2 / Phase B)
SUMO_HOME=/usr/share/sumo
SUMO_HEADLESS=true
SUMO_GUI=false

# Security & RBAC (Simulation demonstration token)
API_SECRET_KEY=synchroflow-edge-rsu-secret-token
